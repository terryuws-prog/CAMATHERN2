# HTTPS relay for the cellular nodes (u-blox SARA-R410M).
#
# The modem cannot complete a TLS handshake with the Cloudflare-fronted
# rivermonitor.aber.ac.uk, so the nodes connect here instead. This server has an
# RSA certificate and also accepts older TLS 1.2 cipher suites, then forwards
# API requests unchanged to rivermonitor. Data still goes to the same database
# and shows on https://rivermonitor.aber.ac.uk/cam/.
#
# ${RELAY_DOMAIN}, ${UPSTREAM_SCHEME} and ${UPSTREAM_HOST} are filled in from the
# environment when the container starts (nginx image templates).

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/${RELAY_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${RELAY_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # Modern suites first, then older ones (RSA key exchange, CBC) for IoT modems.
    ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA:ECDHE-RSA-AES256-SHA:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:@SECLEVEL=0;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 1h;

    client_max_body_size 900k;

    # Resolve the upstream at request time (Docker's DNS), so the relay starts
    # even if DNS is briefly unavailable.
    resolver 127.0.0.11 valid=300s ipv6=off;
    set $upstream ${UPSTREAM_SCHEME}://${UPSTREAM_HOST};

    # Only the API is relayed: uploads, dashboard data and the dev health check.
    location ~ ^/cam/(api|dev/api)/|^/cam/dev/healthz$ {
        proxy_pass $upstream;
        proxy_set_header Host ${UPSTREAM_HOST};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_ssl_name ${UPSTREAM_HOST};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_connect_timeout 15s;
        proxy_read_timeout 60s;
    }

    location / {
        default_type text/plain;
        return 404 "Sensor upload relay. Use /cam/api/v1/readings or /cam/dev/api/v1/readings.\n";
    }
}
